<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.proyektmii">

    <!-- Permission umum -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Permission untuk CloudPOS (EDC Wizar/EDS) -->
    <uses-permission android:name="android.permission.CLOUDPOS_PRINTER" />
    <uses-permission android:name="android.permission.CLOUDPOS_SMARTCARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_MSR" />
    <uses-permission android:name="android.permission.CLOUDPOS_CONTACTLESS_CARD" />
    <uses-permission android:name="android.permission.CLOUDPOS_SERIAL" />
    <uses-permission android:name="android.permission.CLOUDPOS_LED" />
    <uses-permission android:name="android.permission.CLOUDPOS_FINGERPRINT" />
    <uses-permission android:name="android.permission.CLOUDPOS_DISABLE_HOME_KEY_IN_ACTIVITY" />
    <uses-permission android:name="android.permission.CLOUDPOS_DEFAULT_LAUNCHER" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_GET_PIN_BLOCK" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_MAC" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_ENCRYPT_DATA" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_UPDATE_USER_KEY" />
    <uses-permission android:name="android.permission.CLOUDPOS_PIN_UPDATE_MASTER_KEY" />

    <!-- NFC (opsional) -->
    <uses-permission android:name="android.permission.NFC"/>
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="true"
        android:icon="@drawable/tmii_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/tmii_logo"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="22">

        <!-- Jadikan Onboarding sebagai LAUNCHER pertama -->
        <activity
            android:name=".ui.screens.OnboardingActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity tetap ada, tapi tanpa intent-filter LAUNCHER -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- Activity lain tetap seperti semula -->
        <activity android:name=".ui.screens.CanteenMenuActivity" android:exported="true" />
        <activity android:name=".ui.screens.CartActivity" android:exported="true" />
        <activity android:name=".ui.screens.CheckBalanceActivity" android:exported="true" />
        <activity android:name=".ui.screens.DestinationMenuActivity" android:exported="true" />
        <activity android:name=".ui.screens.DestinationSelectionActivity" android:exported="true" />
        <activity android:name=".ui.screens.PintuMasukActivity" android:exported="true" />
        <activity android:name=".ui.screens.ParkingActivity" android:exported="true" />
        <activity android:name=".ui.screens.ParkingSuccessActivity" android:exported="true" />
        <activity android:name=".ui.screens.ParkingCheckoutSuccessActivity" android:exported="true" />
        <activity android:name=".ui.screens.PaymentActivity" android:exported="true" />
        <activity android:name=".ui.screens.PaymentSuccessActivity" android:exported="true" />
        <activity android:name=".ui.screens.PintuMasukSuksesActivity" android:exported="true" />
        <activity android:name=".ui.screens.NfcPaymentActivity" android:exported="true" />
        <activity android:name=".ui.screens.TicketPaymentActivity" android:exported="true" />

    </application>
</manifest>
