<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPintu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pintu_gradient">

    <!-- Background top -->
    <ImageView
        android:id="@+id/ivAwanTop"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/awan"
        android:contentDescription="@string/bg_top" />

    <!-- Background bottom -->
    <ImageView
        android:id="@+id/ivOmbakBottom"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/ombak"
        android:contentDescription="@string/bg_ombak" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="50dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btnBackPintu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg_white"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/tvPintuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/pintu_masuk"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/tmii_logo"
                android:contentDescription="@string/logo_tmii" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="60dp" />

        <!-- Center content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivCard"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/kartu"
                android:contentDescription="@string/card_image" />

            <Space android:layout_height="15dp" android:layout_width="match_parent" />

            <TextView
                android:id="@+id/tvTapCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/silahkan_tap_kartu"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Space android:layout_height="8dp" android:layout_width="match_parent" />

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:foregroundGravity="center">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_light_bg" />

                <!-- border effect -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:background="@android:color/transparent"
                    android:foreground="@drawable/rounded_border_yellow" />

                <ImageView
                    android:id="@+id/ivNfc"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:src="@drawable/nfc"
                    android:contentDescription="@string/nfc_icon" />
            </FrameLayout>

            <Space android:layout_height="16dp" android:layout_width="match_parent" />

            <Button
                android:id="@+id/btnSimulateTap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/simulate_nfc"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>