<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootParkingCheckin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Ombak bottom -->
    <ImageView
        android:id="@+id/ivOmbak"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/ombak"
        android:contentDescription="@string/bg_ombak" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="50dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btnBackPark"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg_white"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/parkir"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <Space android:layout_width="40dp" android:layout_height="wrap_content"/>
        </LinearLayout>

        <View android:layout_height="0dp" android:layout_weight="0.8" android:layout_width="match_parent"/>

        <!-- Circle with car -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rounded_light_bg"/>

                <ImageView
                    android:id="@+id/ivCar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/mobil"
                    android:contentDescription="@string/car_image" />
            </FrameLayout>

            <Space android:layout_height="8dp" android:layout_width="match_parent" />

            <TextView
                android:id="@+id/tvParkTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parkir"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="8dp" />
        </LinearLayout>

        <View android:layout_height="0dp" android:layout_weight="1" android:layout_width="match_parent"/>

        <!-- Simulate check-in button -->
        <Button
            android:id="@+id/btnCheckin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:text="@string/checkin"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white" />
    </LinearLayout>
</FrameLayout>
