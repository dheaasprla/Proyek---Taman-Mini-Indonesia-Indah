<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    card:cardCornerRadius="12dp"
    card:cardElevation="4dp">

    <LinearLayout
        android:padding="12dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgTicket"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/museum"/>

        <LinearLayout
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTicketName"
                android:text="Nama"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvTicketPrice"
                android:text="Rp 0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/darker_gray"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/rounded_light_bg"
            android:padding="6dp">
            <Button
                android:id="@+id/btnTicketDec"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="−"/>
            <TextView
                android:id="@+id/tvTicketQty"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="1"/>
            <Button
                android:id="@+id/btnTicketInc"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
