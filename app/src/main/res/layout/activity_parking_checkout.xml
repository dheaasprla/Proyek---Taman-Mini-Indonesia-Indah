<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootParkingCheckout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ImageView
        android:id="@+id/ivAwanTop"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/awan" />

    <ImageView
        android:id="@+id/ivOmbak"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/ombak" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="50dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">
                <ImageButton
                    android:id="@+id/btnBackCheckout"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_bg_white"
                    android:src="@drawable/ic_arrow_back" />
                <TextView
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/pembayaran_parkir"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/tmii_logo" />
            </LinearLayout>

            <!-- Card Rincian -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_light_bg"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:text="@string/rincian_parkir"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp">
                    <TextView android:text="@string/waktu_masuk" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvEntryTime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">
                    <TextView android:text="@string/waktu_keluar" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvExitTime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:textSize="16sp"/>
            </LinearLayout>

            <Space android:layout_height="20dp" android:layout_width="match_parent"/>

            <!-- NFC area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/kartu" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/silahkan_tap_kartu"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:paddingTop="12dp"/>

                <FrameLayout
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp">

                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/rounded_light_bg" />
                    <ImageView
                        android:id="@+id/ivNfcCheckout"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:src="@drawable/nfc"/>
                </FrameLayout>

                <Space android:layout_height="12dp" android:layout_width="match_parent"/>

                <Button
                    android:id="@+id/btnSimulateNfcCheckout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/simulate_nfc"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <Space android:layout_height="24dp" android:layout_width="match_parent"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
