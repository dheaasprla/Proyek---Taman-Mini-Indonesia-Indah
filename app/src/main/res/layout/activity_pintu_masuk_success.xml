<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPintuSuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <ImageView
        android:id="@+id/ivAwanTopSuccess"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/awan"
        android:contentDescription="@string/bg_top" />

    <ImageView
        android:id="@+id/ivAwanBottomSuccess"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/awan"
        android:contentDescription="@string/bg_bottom" />

    <ImageView
        android:id="@+id/ivOmbakSuccess"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/ombak"
        android:contentDescription="@string/bg_ombak" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:gravity="top|center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="40dp">

            <ImageButton
                android:id="@+id/btnBackSuccess"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg_white"
                android:src="@drawable/ic_arrow_back" />

            <Space android:layout_width="16dp" android:layout_height="wrap_content" />
        </LinearLayout>

        <Space android:layout_height="60dp" android:layout_width="match_parent"/>

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/berhasil"
            android:contentDescription="@string/success" />

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/success_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/tvSuccessSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/please_enter"
            android:gravity="center"
            android:paddingTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
