<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCheckBalance"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_check_balance">

    <!-- Background Awan Top -->
    <ImageView
        android:id="@+id/ivAwanTop"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/awan"
        android:contentDescription="@string/bg_top" />

    <!-- Background Awan Bottom -->
    <ImageView
        android:id="@+id/ivAwanBottom"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/awan"
        android:contentDescription="@string/bg_bottom" />

    <!-- Ombak -->
    <ImageView
        android:id="@+id/ivOmbak"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/ombak"
        android:contentDescription="@string/bg_ombak" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="50dp"
            android:paddingBottom="30dp">

            <ImageButton
                android:id="@+id/btnBackCheck"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg_white"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/tvCheckTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cek_saldo"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Space android:layout_width="40dp" android:layout_height="wrap_content"/>
        </LinearLayout>

        <Space android:layout_height="16dp" android:layout_width="match_parent"/>

        <TextView
            android:id="@+id/tvInstruksi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/silahkan_tap_kartu"
            android:textSize="20sp"
            android:textStyle="italic"
            android:gravity="center" />

        <Space android:layout_height="30dp" android:layout_width="match_parent"/>

        <!-- NFC tap area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/rounded_light_bg" />

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_margin="0dp"
                android:background="@drawable/bordered_card_primary"
                />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:padding="20dp"
                android:layout_gravity="center">
                <ImageView
                    android:id="@+id/ivNfcIcon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:src="@drawable/nfc"
                    android:contentDescription="@string/nfc_icon" />

                <ProgressBar
                    android:id="@+id/pbProcessing"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Card info display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_light_bg"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/id_kartu"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/box_yellow_light"
                    android:padding="12dp"
                    android:text="xxxxxxxxxxxxxx"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saldo"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/box_yellow_light"
                    android:padding="16dp"
                    android:text="Rp ..."
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_height="24dp" android:layout_width="match_parent"/>

        <!-- Simulate button for dev -->
        <Button
            android:id="@+id/btnSimulateCheck"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/simulate_nfc"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>