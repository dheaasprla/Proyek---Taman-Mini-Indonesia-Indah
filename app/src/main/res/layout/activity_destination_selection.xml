<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.screens.DestinationSelectionActivity">

    <ImageView
        android:id="@+id/background_ombak"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:src="@drawable/ombak"
        android:scaleType="fitXY"
        android:contentDescription="@string/background_ombak"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="50dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/back_button_destinasi_selection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/rounded_back_button"
                android:src="@drawable/ic_arrow_back_black"
                android:contentDescription="@string/back_button"/>

            <TextView
                android:id="@+id/destination_selection_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/destination_selection_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

        </RelativeLayout>

        <GridView
            android:id="@+id/destination_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="2"
            android:verticalSpacing="16dp"
            android:horizontalSpacing="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"/>

        <Button
            android:id="@+id/lanjut_ke_keranjang_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/lanjut_ke_keranjang"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:textColor="@color/white"
            android:backgroundTint="#1976D2"
            android:background="@drawable/rounded_button_blue"
            android:enabled="false"/>
    </LinearLayout>
</RelativeLayout>