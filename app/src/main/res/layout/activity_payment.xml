<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPayment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ImageView
        android:id="@+id/bgTop"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/awan"
        android:contentDescription="@string/bg_top" />

    <ImageView
        android:id="@+id/bgBottom"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/ombak"
        android:contentDescription="@string/bg_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="24dp">

            <ImageButton
                android:id="@+id/btnBackPayment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg_white"
                android:src="@drawable/ic_arrow_back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pembayaran"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/tmii_logo" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: Rp 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="24dp"/>

        <Space android:layout_height="24dp" android:layout_width="match_parent"/>

        <ImageView
            android:id="@+id/imgTapCard"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:src="@drawable/kartu"/>

        <TextView
            android:id="@+id/tvTapStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_card"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"/>

        <ProgressBar
            android:id="@+id/progressPayment"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSimulateNfc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/simulate_nfc"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</FrameLayout>
