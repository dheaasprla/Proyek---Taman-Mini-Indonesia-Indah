<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootParkingCheckoutSuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <ImageView android:layout_width="match_parent" android:layout_height="300dp" android:src="@drawable/awan" />
    <ImageView android:layout_width="match_parent" android:layout_height="350dp" android:layout_gravity="bottom" android:src="@drawable/awan" />
    <ImageView android:layout_width="match_parent" android:layout_height="250dp" android:layout_gravity="bottom" android:src="@drawable/ombak" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|center_horizontal"
        android:paddingHorizontal="24dp">

        <ImageButton
            android:id="@+id/btnBackCheckoutSuccess"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_bg_white"
            android:src="@drawable/ic_arrow_back" />

        <Space android:layout_height="40dp" android:layout_width="match_parent" />

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/berhasil" />

        <TextView
            android:id="@+id/tvCheckoutSuccessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/success_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/tvCheckoutSuccessSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_may_exit"
            android:gravity="center"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvPaidTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:gravity="center"
            android:textStyle="bold"
            android:paddingTop="12dp"/>
    </LinearLayout>
</FrameLayout>